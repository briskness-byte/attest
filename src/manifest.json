{
  "name": "nos2x-fox (personal build)",
  "description": "Nostr Signer Extension for Firefox \u2014 personal build with an on/off switch, timed rejections and one-click onboarding.",
  "version": "1.20.1",
  "homepage_url": "https://github.com/diegogurpegui/nos2x-fox",
  "browser_specific_settings": {
    "gecko": {
      "id": "nos2x-fox-personal@brisknessbyte.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "manifest_version": 2,
  "icons": {
    "16": "assets/logo/16x16.png",
    "32": "assets/logo/32x32.png",
    "48": "assets/logo/48x48.png",
    "96": "assets/logo/96x96.png",
    "128": "assets/logo/128x128.png"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "nos2x-fox (personal)",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "ext+nostr",
      "name": "nos2x-fox (personal)",
      "uriTemplate": "/nostr-handler.html?uri=%s"
    }
  ],
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    "nostr-provider.js"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self';"
}
